(define (problem btt1-instance)
    (:domain robocup-work-transport)
    (:objects
        robot1 - robot
        slot1 slot2 slot3 - slot
        locstart loc2 loc3 loc5 loc7 locfinish - location
        cube2 cube4 cube5 cube7 - object
        p1l2 p1l3 p1l5 p1l7 - position
    )
    (:init
        (= (carga robot1) 0)
        (= (restantes locstart) 0)
        (= (restantes loc2) 1)
        (= (restantes loc3) 1)
        (= (restantes loc5) 1)
        (= (restantes loc7) 1)
        (= (restantes locfinish) 0)

        (gripper-free robot1)
        (at-robot robot1 locstart)
        (slot-free robot1 slot1)
        (slot-free robot1 slot2)
        (slot-free robot1 slot3)
        
        (obj-at cube2 loc3)
        (obj-at cube4 loc5)
        (obj-at cube5 loc2)
        (obj-at cube7 loc7)
        (position-free loc2 p1l2)
        (position-free loc3 p1l3)
        (position-free loc5 p1l5)
        (position-free loc7 p1l7)

        (connected locstart loc2)
        (connected locstart loc3)
        (connected locstart loc5)
        (connected locstart loc7)
        (connected locstart locfinish)
        (connected loc2 locstart)
        (connected loc2 loc3)
        (connected loc2 loc5)
        (connected loc2 loc7)
        (connected loc2 locfinish)
        (connected loc3 locstart)
        (connected loc3 loc2)
        (connected loc3 loc5)
        (connected loc3 loc7)
        (connected loc3 locfinish)
        (connected loc5 locstart)
        (connected loc5 loc2)
        (connected loc5 loc3)
        (connected loc5 loc7)
        (connected loc5 locfinish)
        (connected loc7 locstart)
        (connected loc7 loc2)
        (connected loc7 loc3)
        (connected loc7 loc5)
        (connected loc7 locfinish)
    )
    (:goal
        (and
            (obj-at cube2 loc2)
            (at-position cube2 loc2 p1l2)
            (obj-at cube7 loc3)
            (at-position cube7 loc3 p1l3)
            (obj-at cube4 loc7)
            (at-position cube4 loc7 p1l7)
            (obj-at cube5 loc5)
            (at-position cube5 loc5 p1l5)
            (at-robot robot1 locfinish)
        )
    )
)